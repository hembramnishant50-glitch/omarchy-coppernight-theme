{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#11111b",
    "bg_dark": "#0b0b12",
    "panel": "#181825",
    "element": "#1e1e2e",
    "fg": "#cdd6f4",
    "muted": "#a6adc8",
    "dim": "#585b70",
    "copper": "#fab387",
    "red": "#f38ba8",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "blue": "#89b4fa",
    "mauve": "#cba6f7",
    "teal": "#94e2d5",
    "pink": "#f5c2e7",
    "sel": "#313244"
  },
  "theme": {
    "primary": {"dark": "copper", "light": "copper"},
    "secondary": {"dark": "blue", "light": "blue"},
    "accent": {"dark": "copper", "light": "copper"},
    "error": {"dark": "red", "light": "red"},
    "warning": {"dark": "yellow", "light": "yellow"},
    "success": {"dark": "green", "light": "green"},
    "info": {"dark": "blue", "light": "blue"},
    "text": {"dark": "fg", "light": "bg"},
    "textMuted": {"dark": "muted", "light": "dim"},
    "background": {"dark": "bg", "light": "fg"},
    "backgroundPanel": {"dark": "panel", "light": "muted"},
    "backgroundElement": {"dark": "element", "light": "muted"},
    "border": {"dark": "dim", "light": "dim"},
    "borderActive": {"dark": "copper", "light": "copper"},
    "borderSubtle": {"dark": "sel", "light": "sel"},
    "diffAdded": {"dark": "green", "light": "green"},
    "diffRemoved": {"dark": "red", "light": "red"},
    "diffContext": {"dark": "dim", "light": "dim"},
    "diffHunkHeader": {"dark": "muted", "light": "muted"},
    "diffHighlightAdded": {"dark": "green", "light": "green"},
    "diffHighlightRemoved": {"dark": "red", "light": "red"},
    "diffAddedBg": {"dark": "panel", "light": "panel"},
    "diffRemovedBg": {"dark": "panel", "light": "panel"},
    "diffContextBg": {"dark": "bg_dark", "light": "bg_dark"},
    "diffLineNumber": {"dark": "muted", "light": "muted"},
    "diffAddedLineNumberBg": {"dark": "panel", "light": "panel"},
    "diffRemovedLineNumberBg": {"dark": "panel", "light": "panel"},
    "markdownText": {"dark": "fg", "light": "bg"},
    "markdownHeading": {"dark": "copper", "light": "copper"},
    "markdownLink": {"dark": "blue", "light": "blue"},
    "markdownLinkText": {"dark": "teal", "light": "teal"},
    "markdownCode": {"dark": "green", "light": "green"},
    "markdownBlockQuote": {"dark": "muted", "light": "muted"},
    "markdownEmph": {"dark": "pink", "light": "pink"},
    "markdownStrong": {"dark": "yellow", "light": "yellow"},
    "markdownHorizontalRule": {"dark": "dim", "light": "dim"},
    "markdownListItem": {"dark": "blue", "light": "blue"},
    "markdownListEnumeration": {"dark": "teal", "light": "teal"},
    "markdownImage": {"dark": "mauve", "light": "mauve"},
    "markdownImageText": {"dark": "teal", "light": "teal"},
    "markdownCodeBlock": {"dark": "fg", "light": "bg"},
    "syntaxComment": {"dark": "muted", "light": "muted"},
    "syntaxKeyword": {"dark": "mauve", "light": "mauve"},
    "syntaxFunction": {"dark": "blue", "light": "blue"},
    "syntaxVariable": {"dark": "teal", "light": "teal"},
    "syntaxString": {"dark": "green", "light": "green"},
    "syntaxNumber": {"dark": "copper", "light": "copper"},
    "syntaxType": {"dark": "yellow", "light": "yellow"},
    "syntaxOperator": {"dark": "blue", "light": "blue"},
    "syntaxPunctuation": {"dark": "muted", "light": "muted"}
  }
}
