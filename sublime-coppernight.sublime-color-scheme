{
  "variables": {
    "bg": "#11111b",
    "bg_dark": "#0b0b12",
    "panel": "#181825",
    "fg": "#cdd6f4",
    "fg_dim": "#a6adc8",
    "muted": "#585b70",
    "copper": "#fab387",
    "red": "#f38ba8",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "blue": "#89b4fa",
    "mauve": "#cba6f7",
    "teal": "#94e2d5",
    "pink": "#f5c2e7",
    "sel": "#313244"
  },
  "globals": {
    "background": "var(bg)",
    "foreground": "var(fg)",
    "caret": "var(copper)",
    "block_caret": "var(copper)",
    "selection": "var(sel)",
    "selection_foreground": "var(fg)",
    "selection_border": "var(sel)",
    "inactive_selection": "var(sel)",
    "line_highlight": "var(bg)",
    "highlight": "var(copper)",
    "find_highlight": "var(yellow)",
    "find_highlight_foreground": "var(bg_dark)",
    "gutter": "var(muted)",
    "gutter_foreground": "var(fg_dim)",
    "gutter_foreground_highlight": "var(copper)",
    "line_diff_added": "var(green)",
    "line_diff_modified": "var(copper)",
    "line_diff_deleted": "var(red)",
    "shadow": "var(bg_dark)",
    "shadow_width": "8",
    "fold_marker": "var(copper)",
    "minimap_selection": "var(copper)",
    "brackets_foreground": "var(fg_dim)",
    "brackets_options": "stippled_underline",
    "bracket_contents_foreground": "var(fg)",
    "bracket_contents_options": "bold",
    "tags_foreground": "var(blue)",
    "tags_options": "stippled_underline",
    "scroll_selected": "var(copper)",
    "scroll_hover": "var(muted)",
    "scroll": "var(muted)",
    "gutter_added": "var(green)",
    "gutter_deleted": "var(red)",
    "gutter_modified": "var(copper)"
  },
  "rules": [
    {"scope": "comment", "foreground": "var(fg_dim)", "font_style": "italic"},
    {"scope": "comment.block.documentation", "foreground": "var(fg_dim)", "font_style": "italic"},
    {"scope": "string", "foreground": "var(green)"},
    {"scope": "string.regexp", "foreground": "var(mauve)"},
    {"scope": "constant.numeric", "foreground": "var(copper)"},
    {"scope": "constant.language.boolean", "foreground": "var(copper)"},
    {"scope": "constant.character.escape", "foreground": "var(mauve)"},
    {"scope": "variable", "foreground": "var(fg)"},
    {"scope": "variable.parameter", "foreground": "var(teal)", "font_style": "italic"},
    {"scope": "entity.name.function", "foreground": "var(blue)"},
    {"scope": "entity.name.type", "foreground": "var(yellow)"},
    {"scope": "entity.name.tag", "foreground": "var(blue)"},
    {"scope": "entity.other.attribute-name", "foreground": "var(teal)"},
    {"scope": "keyword", "foreground": "var(mauve)"},
    {"scope": "keyword.control.import, keyword.control.export", "foreground": "var(blue)"},
    {"scope": "storage.type", "foreground": "var(yellow)"},
    {"scope": "support.function", "foreground": "var(teal)"},
    {"scope": "support.type", "foreground": "var(teal)"},
    {"scope": "punctuation", "foreground": "var(fg_dim)"},
    {"scope": "markup.heading", "foreground": "var(blue)", "font_style": "bold"},
    {"scope": "markup.bold", "foreground": "var(copper)", "font_style": "bold"},
    {"scope": "markup.italic", "foreground": "var(mauve)", "font_style": "italic"},
    {"scope": "markup.underline.link", "foreground": "var(blue)"},
    {"scope": "markup.inserted", "foreground": "var(green)"},
    {"scope": "markup.deleted", "foreground": "var(red)"},
    {"scope": "invalid.illegal", "foreground": "var(red)", "font_style": "bold"},
    {"scope": "invalid.deprecated", "foreground": "var(yellow)", "font_style": "bold italic underline"}
  ]
}
