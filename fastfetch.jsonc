{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/omarchy/themes/coppernight/1.png",
    "width": 32,
    "padding": {
      "top": 1,
      "right": 3,
      "left": 1
    }
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "#9399b2"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} {at-symbol-colored} {host-name-colored}"
    },
    {
      "type": "custom",
      "format": "─────────────────────────",
      "color": "#585b70"
    },
    {
      "type": "command",
      "key": "OS ",
      "keyColor": "#b4befe",
      "text": "version=$(omarchy-version 2>/dev/null); echo \"Omarchy ${version:-unknown}\"",
      "color": "#cdd6f4"
    },
    {
      "type": "kernel",
      "key": "KRN",
      "keyColor": "#b4befe",
      "color": "#cdd6f4"
    },
    {
      "type": "uptime",
      "key": "UPT",
      "keyColor": "#b4befe",
      "color": "#cdd6f4"
    },
    {
      "type": "packages",
      "key": "PKG",
      "keyColor": "#b4befe",
      "color": "#cdd6f4"
    },
    {
      "type": "command",
      "key": "UPD",
      "keyColor": "#b4befe",
      "text": "t=$(stat -c %Y /var/lib/pacman/sync/core.db 2>/dev/null); if [ -n \"$t\" ]; then age=$(( ($(date +%s) - $t) / 86400 )); if [ $age -eq 0 ]; then echo 'Today'; elif [ $age -eq 1 ]; then echo '1 day ago'; else echo \"${age} days ago\"; fi; else echo 'N/A'; fi",
      "color": "#cdd6f4"
    },
    {
      "type": "custom",
      "format": "─────────────────────────",
      "color": "#585b70"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#74c7ec",
      "showPeCoreCount": true,
      "color": "#cdd6f4"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#74c7ec",
      "detectionMethod": "pci",
      "color": "#cdd6f4"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#74c7ec",
      "color": "#cdd6f4"
    },
    {
      "type": "swap",
      "key": "SWP",
      "keyColor": "#74c7ec",
      "color": "#cdd6f4"
    },
    {
      "type": "disk",
      "key": "DSK",
      "keyColor": "#74c7ec",
      "color": "#cdd6f4"
    },
    {
      "type": "custom",
      "format": "─────────────────────────",
      "color": "#585b70"
    },
    {
      "type": "wm",
      "key": "WM ",
      "keyColor": "#f2cdcd",
      "color": "#cdd6f4"
    },
    {
      "type": "terminal",
      "key": "TRM",
      "keyColor": "#f2cdcd",
      "color": "#cdd6f4"
    },
    {
      "type": "shell",
      "key": "SHL",
      "keyColor": "#f2cdcd",
      "color": "#cdd6f4"
    },
    {
      "type": "command",
      "key": "THM",
      "keyColor": "#f2cdcd",
      "text": "theme=$(omarchy-theme-current 2>/dev/null || echo 'unknown'); echo -e \"$theme \\e[38;2;245;224;220m●\\e[38;2;242;205;205m●\\e[38;2;245;194;231m●\\e[38;2;203;166;247m●\\e[38;2;137;180;250m●\\e[38;2;166;227;161m●\\e[38;2;249;226;175m●\\e[38;2;250;179;135m●\"",
      "color": "#cdd6f4"
    },
    {
      "type": "custom",
      "format": "─────────────────────────",
      "color": "#585b70"
    },
    {
      "type": "colors",
      "symbol": "square",
      "blockWidth": 3
    }
  ]
}
