{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/tanjiro-kamado.png",
    "width": 32,
    "padding": {
      "top": 1,
      "right": 4,
      "left": 1
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "separator": "#eed49f"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored} @ {host-name-colored}"
    },
    {
      "type": "custom",
      "format": " ",
      "color": "#eed49f"
    },
    {
      "type": "custom",
      "format": "【 素 ＰＲＯＦＩＬＥ 】",
      "color": "#ed8796"
    },
    {
      "type": "command",
      "key": "  󰍹 ",
      "keyColor": "#ed8796",
      "text": "version=$(omarchy-version 2>/dev/null); echo \"Omarchy ${version:-unknown}\"",
      "color": "#eed49f"
    },
    {
      "type": "kernel",
      "key": "   ",
      "keyColor": "#ed8796",
      "color": "#eed49f"
    },
    {
      "type": "uptime",
      "key": "   ",
      "keyColor": "#ed8796",
      "color": "#eed49f"
    },
    {
      "type": "packages",
      "key": "  󰏖 ",
      "keyColor": "#ed8796",
      "color": "#eed49f"
    },
    {
      "type": "command",
      "key": "  󰚰 ",
      "keyColor": "#ed8796",
      "text": "t=$(stat -c %Y /var/lib/pacman/sync/core.db 2>/dev/null); if [ -n \"$t\" ]; then age=$(( ($(date +%s) - $t) / 86400 )); if [ $age -eq 0 ]; then echo 'Today'; elif [ $age -eq 1 ]; then echo '1 day ago'; else echo \"${age} days ago\"; fi; else echo 'N/A'; fi",
      "color": "#eed49f"
    },
    {
      "type": "custom",
      "format": " ",
      "color": "#eed49f"
    },
    {
      "type": "custom",
      "format": "【 機 ＨＡＲＤＷＡＲＥ 】",
      "color": "#8aadf4"
    },
    {
      "type": "cpu",
      "key": "  󰻠 ",
      "keyColor": "#8aadf4",
      "showPeCoreCount": true,
      "color": "#eed49f"
    },
    {
      "type": "gpu",
      "key": "  󰢮 ",
      "keyColor": "#8aadf4",
      "detectionMethod": "pci",
      "color": "#eed49f"
    },
    {
      "type": "memory",
      "key": "  󰍛 ",
      "keyColor": "#8aadf4",
      "color": "#eed49f"
    },
    {
      "type": "swap",
      "key": "  󰾴 ",
      "keyColor": "#8aadf4",
      "color": "#eed49f"
    },
    {
      "type": "disk",
      "key": "  󰋊 ",
      "keyColor": "#8aadf4",
      "color": "#eed49f"
    },
    {
      "type": "custom",
      "format": " ",
      "color": "#eed49f"
    },
    {
      "type": "custom",
      "format": "【 環 ＥＮＶＩＲＯＮＭＥＮＴ 】",
      "color": "#a6da95"
    },
    {
      "type": "wm",
      "key": "   ",
      "keyColor": "#a6da95",
      "color": "#eed49f"
    },
    {
      "type": "terminal",
      "key": "   ",
      "keyColor": "#a6da95",
      "color": "#eed49f"
    },
    {
      "type": "shell",
      "key": "   ",
      "keyColor": "#a6da95",
      "color": "#eed49f"
    },
    {
      "type": "command",
      "key": "   ",
      "keyColor": "#a6da95",
      "text": "theme=$(omarchy-theme-current 2>/dev/null || echo 'unknown'); echo -e \"$theme \\e[38;2;237;135;150m●\\e[38;2;250;179;135m●\\e[38;2;238;212;159m●\\e[38;2;166;218;149m●\\e[38;2;139;213;202m●\\e[38;2;138;173;244m●\\e[38;2;198;160;246m●\\e[38;2;245;189;230m●\"",
      "color": "#eed49f"
    },
    {
      "type": "custom",
      "format": " ",
      "color": "#eed49f"
    },
    {
      "type": "colors",
      "symbol": "diamond",
      "blockWidth": 4
    }
  ]
}